{
  "components": {
    "schemas": {
      "CapabilitiesSchema": {
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/CapabilitySchema"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "degradations": {
            "items": {
              "$ref": "#/components/schemas/DegradationSchema"
            },
            "title": "Degradations",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "capabilities",
          "degradations"
        ],
        "title": "CapabilitiesSchema",
        "type": "object"
      },
      "CapabilitySchema": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "planned_slice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Slice"
          },
          "status": {
            "$ref": "#/components/schemas/CapabilityStatus"
          }
        },
        "required": [
          "id",
          "label",
          "status",
          "detail"
        ],
        "title": "CapabilitySchema",
        "type": "object"
      },
      "CapabilityStatus": {
        "description": "Estado real de una capacidad. Nada se declara operativo sin comprobarlo.",
        "enum": [
          "enabled",
          "disabled",
          "unavailable",
          "configured_unverified",
          "planned"
        ],
        "title": "CapabilityStatus",
        "type": "string"
      },
      "CheckSchema": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ],
        "title": "CheckSchema",
        "type": "object"
      },
      "DegradationSchema": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "DegradationSchema",
        "type": "object"
      },
      "EmbeddingSettingsSchema": {
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider"
        ],
        "title": "EmbeddingSettingsSchema",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "LiveSchema": {
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "LiveSchema",
        "type": "object"
      },
      "LlmSettingsSchema": {
        "properties": {
          "api_key_configured": {
            "title": "Api Key Configured",
            "type": "boolean"
          },
          "base_url_configured": {
            "title": "Base Url Configured",
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "sends_data_off_device": {
            "title": "Sends Data Off Device",
            "type": "boolean"
          }
        },
        "required": [
          "provider",
          "base_url_configured",
          "api_key_configured",
          "sends_data_off_device"
        ],
        "title": "LlmSettingsSchema",
        "type": "object"
      },
      "OcrSettingsSchema": {
        "properties": {
          "tesseract_available": {
            "title": "Tesseract Available",
            "type": "boolean"
          },
          "tesseract_configured": {
            "title": "Tesseract Configured",
            "type": "boolean"
          }
        },
        "required": [
          "tesseract_configured",
          "tesseract_available"
        ],
        "title": "OcrSettingsSchema",
        "type": "object"
      },
      "ProblemDetail": {
        "description": "Cuerpo de error del contrato.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "field_errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlation_id"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadinessSchema": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckSchema"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessSchema",
        "type": "object"
      },
      "SettingsSchema": {
        "description": "Configuración efectiva sanitizada. Nunca incluye secretos.",
        "properties": {
          "cors_origins": {
            "items": {
              "type": "string"
            },
            "title": "Cors Origins",
            "type": "array"
          },
          "data_dir": {
            "title": "Data Dir",
            "type": "string"
          },
          "database_file": {
            "title": "Database File",
            "type": "string"
          },
          "disk_free_bytes": {
            "title": "Disk Free Bytes",
            "type": "integer"
          },
          "disk_total_bytes": {
            "title": "Disk Total Bytes",
            "type": "integer"
          },
          "editable": {
            "title": "Editable",
            "type": "boolean"
          },
          "embeddings": {
            "$ref": "#/components/schemas/EmbeddingSettingsSchema"
          },
          "host": {
            "title": "Host",
            "type": "string"
          },
          "llm": {
            "$ref": "#/components/schemas/LlmSettingsSchema"
          },
          "log_level": {
            "title": "Log Level",
            "type": "string"
          },
          "ocr": {
            "$ref": "#/components/schemas/OcrSettingsSchema"
          },
          "port": {
            "title": "Port",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "host",
          "port",
          "log_level",
          "data_dir",
          "database_file",
          "disk_total_bytes",
          "disk_free_bytes",
          "cors_origins",
          "llm",
          "embeddings",
          "ocr",
          "editable"
        ],
        "title": "SettingsSchema",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API local de OpoFuente. Escucha solo en loopback y no tiene autenticación: es una aplicación de un único usuario. Ninguna respuesta contiene claves ni contenido privado en logs. Especificación en docs/product-spec.",
    "title": "OpoFuente API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesSchema"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capacidades reales y degradaciones"
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "No comprueba dependencias: solo que el proceso responde.",
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveSchema"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Proceso vivo"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessSchema"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {}
            },
            "description": "Alguna dependencia no está lista; incluye `checks` como extensión."
          }
        },
        "summary": "Listo para servir (comprueba la base de datos)"
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "read_settings_api_v1_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSchema"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Configuración efectiva sanitizada (sin secretos)"
      }
    }
  }
}
