# OpoFuente — configuración local de ejemplo.
# Copiar a .env (ignorado por git). NUNCA poner secretos en el repositorio.
#
# Prioridad: valores seguros por defecto -> fichero local (.env) -> variables de entorno.
# Rutas relativas se resuelven contra la raíz del repositorio.

# --- Almacenamiento -----------------------------------------------------------
# Directorio de datos: DB, artefactos, representaciones, Qdrant, logs y backups.
OPOFUENTE_DATA_DIR=data

# --- Servidor local -----------------------------------------------------------
# Solo se admite loopback. Un host público falla al arrancar (09_SECURITY §2).
OPOFUENTE_HOST=127.0.0.1
OPOFUENTE_PORT=8765
OPOFUENTE_LOG_LEVEL=INFO

# Orígenes del frontend autorizados (CORS + comprobación de Origin).
# OPOFUENTE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]

# --- IA (desactivada por defecto; 13_DECISIONS Q003) --------------------------
# disabled | openai_compatible | ollama
OPOFUENTE_LLM_PROVIDER=disabled
# Si el proveedor no es disabled, base_url y model son obligatorios.
OPOFUENTE_LLM_BASE_URL=
OPOFUENTE_LLM_MODEL=
# Clave solo por variable de entorno. Nunca se devuelve por la API ni se registra en logs.
OPOFUENTE_LLM_API_KEY=

# --- Embeddings (S09) ---------------------------------------------------------
# disabled | local | openai_compatible
OPOFUENTE_EMBEDDING_PROVIDER=disabled
OPOFUENTE_EMBEDDING_MODEL=

# --- OCR opcional (Tesseract) -------------------------------------------------
# Ruta al binario. Si no se indica, el OCR queda desactivado y las imágenes y los PDF escaneados
# quedan `ocr_pending` con su aviso; si la ruta no existe o el binario no tiene el idioma pedido,
# /capabilities lo dice con el motivo exacto.
OPOFUENTE_TESSERACT_PATH=
# Idiomas del OCR, en la forma de Tesseract (`spa`, `spa+eng`). Sin el idioma, el OCR NO se da por
# operativo: un OCR en inglés sobre texto español produce texto plausible y equivocado.
OPOFUENTE_TESSERACT_LANGUAGES=spa
# Directorio de modelos (`tessdata`). Si se deja vacío se usa `%LOCALAPPDATA%\OpoFuente\tessdata`
# cuando existe (el `tessdata` del instalador está en `Program Files`, que no es escribible sin
# administrador); si no existe, manda el que tenga Tesseract. Ver docs/OPERACION.md §8.
OPOFUENTE_TESSERACT_TESSDATA=

# --- Ingestión y worker local (S02) ------------------------------------------
# Worker en el propio proceso: consume la cola persistida en SQLite (sin Redis ni Celery).
# Con `false`, los lotes se encolan y no avanzan; /capabilities lo declara como desactivado.
OPOFUENTE_WORKER_ENABLED=true
# Cada cuánto mira la cola cuando no hay trabajo (segundos).
OPOFUENTE_WORKER_POLL_SECONDS=1.0
# Duración del lease de un trabajo. Si el proceso muere, el trabajo vuelve a la cola al arrancar.
OPOFUENTE_JOB_LEASE_SECONDS=60
# Límites de seguridad de la ingesta (por fichero y por lote).
OPOFUENTE_MAX_FILE_BYTES=536870912
OPOFUENTE_MAX_BATCH_ENTRIES=50000

# --- Extracción (S03) ---------------------------------------------------------
# Caracteres por representación: por encima se recorta y se avisa en la propia representación.
OPOFUENTE_MAX_REPRESENTATION_CHARS=2000000
# Páginas por PDF: una guía enorme no puede agotar la memoria.
OPOFUENTE_MAX_PDF_PAGES=2000
# Límites de un ZIP (propio o dentro de un DOCX): entradas, bytes descomprimidos, ratio y
# anidamiento. Un contenedor que los supere se rechaza entero con su incidencia.
OPOFUENTE_MAX_ZIP_ENTRIES=2000
OPOFUENTE_MAX_ZIP_UNCOMPRESSED_BYTES=1073741824
OPOFUENTE_MAX_ZIP_RATIO=200
OPOFUENTE_MAX_ZIP_DEPTH=1

# --- Entrada por URL (S03) ----------------------------------------------------
# Solo http/https; cada redirección se revalida y las redes internas se bloquean (09_SECURITY §4).
OPOFUENTE_URL_TIMEOUT_SECONDS=20.0
OPOFUENTE_MAX_URL_BYTES=67108864
OPOFUENTE_MAX_URL_REDIRECTS=5
# Texto pegado (04_INGESTION §2): tope de tamaño del contenido que se guarda como material propio.
OPOFUENTE_MAX_PASTE_BYTES=4194304
# Cuánto puede leer cada extractor de un fichero (S03). El texto, el HTML y el CSV se leen hasta
# este tope (si hay más, se lee el principio y se avisa); el JSON hay que parsearlo entero, así que
# si no cabe se declara en lugar de cargarlo en memoria; una imagen mayor que su tope se conserva
# sin describirla. Sin estos límites, un fichero válido de 512 MiB agotaba la memoria del equipo.
OPOFUENTE_MAX_TEXT_BYTES=33554432
OPOFUENTE_MAX_JSON_BYTES=8388608
OPOFUENTE_MAX_IMAGE_BYTES=268435456

# --- Frontend (Vite) ----------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8765

# --- Plataforma desplegable (S28, §8 a §11 del objetivo vivo) ------------------
# Las cuatro banderas nacen APAGADAS: con las cuatro a 0 la aplicación se comporta exactamente como
# antes para quien estudia sin cuenta, y esa es la primera prueba del bloque. Se encienden de una en
# una y a propósito.
#
# Cuentas y sesiones (§8). Encendida, la API de administración deja de ser abierta (exige sesión) y
# las rutas de la cuenta contestan 401 sin ella. La zona de estudio SIGUE ABIERTA: se puede estudiar
# sin cuenta, que es la regla que manda en todo el bloque.
OPOFUENTE_ACCOUNTS_ENABLED=0
# Páginas legales, aviso de cookies y control de datos (§9).
OPOFUENTE_LEGAL_ENABLED=0
# Analítica propia (§10): agregada, sin identificadores y solo con consentimiento. EXIGE el marco
# legal encendido, porque el consentimiento se pide con las rutas del §9.
OPOFUENTE_ANALYTICS_ENABLED=0
# Pagos (§11): SOLO el hueco. No hay ninguna pasarela integrada ni ninguna cuenta creada. EXIGE el
# marco legal encendido, porque los datos que recibiría un tercero tienen que estar declarados en la
# política de privacidad antes de que ocurran.
OPOFUENTE_PAYMENTS_ENABLED=0

# La cookie de la sesión. `lax` impide que la mande una petición que venga de otro sitio, y la
# comprobación de `Origin` sigue siendo la primera defensa contra el CSRF.
OPOFUENTE_SESSION_COOKIE_SAME_SITE=lax
# `Secure` está APAGADO porque la aplicación escucha en http://127.0.0.1: con él, la cookie no se
# pondría nunca. El día que se sirva por HTTPS, ponlo a 1.
OPOFUENTE_SESSION_COOKIE_SECURE=0
# Cuántas horas dura una sesión sin volver a entrar (30 días).
OPOFUENTE_SESSION_TTL_HOURS=720

# Dónde vive la web cuando se despliegue, para poder componer el enlace de recuperación. Vacío
# significa «el primer origen autorizado», que es el servidor de la web en local.
# OPOFUENTE_PUBLIC_BASE_URL=https://ejemplo.es

# ¿Hay servicio de correo contratado? HOY NO, y por eso está en 0. Ponerlo a 1 **falla al arrancar**
# mientras no haya proveedor implementado, en lugar de dejar el enlace de recuperación creyendo que
# se ha mandado un mensaje: mientras esté a 0, el enlace se deja en datos/recovery/ para que lo lea
# el titular (ver PARA-EL-PROPIETARIO.md).
OPOFUENTE_MAIL_ENABLED=0

# Coste de argon2id para las contraseñas. Los valores por defecto son los de la biblioteca; se bajan
# en las pruebas (no se mide el tiempo, se mide qué se guarda) y no deberían bajarse aquí.
OPOFUENTE_PASSWORD_HASH_TIME_COST=3
OPOFUENTE_PASSWORD_HASH_MEMORY_COST_KIB=65536
OPOFUENTE_PASSWORD_HASH_PARALLELISM=4
