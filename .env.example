# OpoFuente — configuración local de ejemplo.
# Copiar a .env (ignorado por git). NUNCA poner secretos en el repositorio.
#
# Prioridad: valores seguros por defecto -> fichero local (.env) -> variables de entorno.
# Rutas relativas se resuelven contra la raíz del repositorio.

# --- Almacenamiento -----------------------------------------------------------
# Directorio de datos: DB, artefactos, representaciones, Qdrant, logs y backups.
OPOFUENTE_DATA_DIR=data

# --- Servidor local -----------------------------------------------------------
# Solo se admite loopback. Un host público falla al arrancar (09_SECURITY §2).
OPOFUENTE_HOST=127.0.0.1
OPOFUENTE_PORT=8765
OPOFUENTE_LOG_LEVEL=INFO

# Orígenes del frontend autorizados (CORS + comprobación de Origin).
# OPOFUENTE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]

# --- IA (desactivada por defecto; 13_DECISIONS Q003) --------------------------
# disabled | openai_compatible | ollama
OPOFUENTE_LLM_PROVIDER=disabled
# Si el proveedor no es disabled, base_url y model son obligatorios.
OPOFUENTE_LLM_BASE_URL=
OPOFUENTE_LLM_MODEL=
# Clave solo por variable de entorno. Nunca se devuelve por la API ni se registra en logs.
OPOFUENTE_LLM_API_KEY=

# --- Embeddings (S09) ---------------------------------------------------------
# disabled | local | openai_compatible
OPOFUENTE_EMBEDDING_PROVIDER=disabled
OPOFUENTE_EMBEDDING_MODEL=

# --- OCR opcional (Tesseract) -------------------------------------------------
# Si se indica una ruta inexistente, la capacidad se reporta como no disponible.
OPOFUENTE_TESSERACT_PATH=

# --- Frontend (Vite) ----------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8765
